# Copy to terraform.tfvars and adjust as needed.
# Do not commit terraform.tfvars if it contains environment-specific secrets or IPs.

aws_region         = "us-east-1"
cluster_name       = "devops-kubernetes-learning"
kubernetes_version = "1.35"

vpc_cidr               = "10.0.0.0/16"
availability_zones     = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs    = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs   = ["10.0.10.0/24", "10.0.11.0/24"]

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 3
node_disk_size      = 20

# kubectl from outside the EKS VPC (Windows). Never use 0.0.0.0/0.
endpoint_private_access = true
endpoint_public_access  = true
public_access_cidrs     = ["103.206.8.252/32"]

# Empty = no CloudWatch control-plane logs (saves cost). Example:
# enable_cluster_log_types = ["api", "audit", "authenticator"]
enable_cluster_log_types = []

common_tags = {
  Project     = "devops-take-home"
  Environment = "dev"
  ManagedBy   = "terraform"
}
